{
    "name": "mk-josias/laravel-distributable-rpc-http",
    "description": "HTTP driver for the RPC of mk-josias/laravel-distributable: signed calls between services, one endpoint per service.",
    "homepage": "https://mk-josias.github.io/laravel-distributable/",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "microservices",
        "rpc",
        "http"
    ],
    "authors": [
        {
            "name": "Josias Mekontso",
            "email": "josiasmekontso.it@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "mk-josias/laravel-distributable": "self.version"
    },
    "suggest": {
        "laravel/octane": "Serves the RPC on a port of its own: rpc:serve"
    },
    "autoload": {
        "psr-4": {
            "Distributable\\RpcHttp\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Distributable\\RpcHttp\\RpcHttpServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
